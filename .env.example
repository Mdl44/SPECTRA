# Copy to .env and fill in real values. .env is gitignored -- never commit real secrets.

SPECTRA_SNMPV3_USER=noc-agent
SPECTRA_SNMPV3_AUTH_KEY=changeme
SPECTRA_SNMPV3_PRIV_KEY=changeme

# SNMPv2c read-only community end hosts run (topologies/GNS3/host/snmpd.conf),
# used by tools/discover.py to pull sysName/sysDescr for end-host identity.
# Not a real secret (read-only, lab-only, already plaintext in that file).
# Opportunistic only -- most real end hosts don't run SNMP at all.
SPECTRA_SNMP_HOST_COMMUNITY=public

# Optional: SSH into an ISC dhcpd (isc-dhcp-server) box to read real DHCP
# lease hostnames -- the most universal end-host ID signal there is, since
# virtually any DHCP client sends its hostname regardless of OS. Leave any
# of these three unset to skip this source entirely (SNMP + NetBIOS/mDNS
# fallback still run on their own). Only ISC dhcpd's lease file format is
# supported; a different DHCP server would need its own fetch function.
SPECTRA_DHCP_SERVER_HOST=10.0.14.142
SPECTRA_DHCP_SERVER_SSH_USER=spectra
SPECTRA_DHCP_SERVER_SSH_PASSWORD=changeme

# Optional: comma-separated names of this host's own NICs that only ever
# act as a bridge/uplink onto the monitored network (e.g. a GNS3 Cloud node's
# physical interface) and should never be reported as an end device. Other
# local interfaces (a tap device standing in for a real laptop/VM you want
# discovered) are left alone. Leave unset if this host has no such interface.
SPECTRA_BRIDGE_INTERFACES=eth0

# Device SSH login, used by tools/discover.py for CAM/FDB tables and by
# tools/wipe_and_restore.py for config push. Same account as each config's
# `username Admin01 ...` line.
SPECTRA_SSH_USER=Admin01
SPECTRA_SSH_PASSWORD=changeme

# GNS3 controller API (used by tools/wipe_and_restore.py). Leave GNS3_USER
# unset if your GNS3 server doesn't have API auth enabled.
GNS3_BASE_URL=http://localhost:3080
GNS3_USER=admin
GNS3_PASSWORD=changeme

# App database (see db/schema.sql), used by tools/discover.py and tools/audit_configs.py.
SPECTRA_DB_URL=postgresql+psycopg2://spectra:changeme@127.0.0.1:5432/campus_db
